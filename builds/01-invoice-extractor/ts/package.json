{
  "name": "invoice-extractor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PDF invoice -> Claude structured output -> zod-validated JSON (TypeScript twin of ../extractor)",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "extract": "tsx src/cli.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "pdf-parse": "2.4.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
