# Copy to n8n/.env and fill in. Never commit n8n/.env.
N8N_PORT=5678
N8N_USER_FOLDER=C:/Automations/n8n/data
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
GENERIC_TIMEZONE=America/New_York
# LLM key used by Code nodes / HTTP nodes in demos (client supplies their own on paid gigs)
ANTHROPIC_API_KEY=
# DevSnipe job-feed API key (gigs/devsnipe.py reads it)
DEVSNIPE_API_KEY=
