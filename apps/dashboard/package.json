{
  "name": "automation-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One-page dashboard over the automations database: invoices, leads, inbox triage. Node + pg + plain HTML, no framework.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.69.0",
    "vitest": "2.1.8"
  }
}
